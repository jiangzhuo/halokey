{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "halokey",
  "version": "0.0.1",
  "identifier": "dev.halokey.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "devUrl": "http://localhost:5177",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "halokey",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      },
      {
        "label": "halo",
        "title": "halo",
        "url": "halo.html",
        "width": 360,
        "height": 388,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "halokey"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-halokey.rules": "../../packaging/linux/70-halokey.rules"
        }
      }
    },
    "category": "Utility",
    "shortDescription": "Control center for the Ulanzi Vibe Key (AU05)",
    "longDescription": "Remap the keys and knob, run host-side actions, use the halo radial menu, and manage lighting. Installs a udev rule for /dev/hidraw and /dev/uinput; replug the receiver after installing."
  }
}