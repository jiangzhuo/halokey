{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "halokey",
  "version": "0.0.1",
  "identifier": "dev.halokey.app",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "halokey",
        "url": "index.html",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "halo",
        "title": "halo",
        "url": "halo.html",
        "width": 420,
        "height": 420,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "halokey"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
